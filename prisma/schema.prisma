// Prisma Schema for Healthcare ERP Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  NURSE
  PHARMACIST
  RECEPTIONIST
  LAB_TECHNICIAN
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
  TRANSFERRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

model Organization {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique
  description String?
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  branches    Branch[]
  users       User[]
  patients    Patient[]

  @@index([code])
  @@index([status])
  @@index([deletedAt])
  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  code           String
  status         BranchStatus @default(ACTIVE)
  address        String?      @map("address")
  phoneNumber    String?      @map("phone_number")
  email          String?      @map("email")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  patients       Patient[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([code])
  @@index([status])
  @@index([deletedAt])
  @@map("branches")
}

model User {
  id             String        @id @default(uuid())
  organizationId String?       @map("organization_id")
  branchId       String?       @map("branch_id")
  email          String        @unique
  passwordHash   String        @map("password_hash")
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  role           Role          @default(RECEPTIONIST)
  status         UserStatus    @default(ACTIVE)
  phoneNumber    String?       @map("phone_number")
  avatarUrl      String?       @map("avatar_url")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  auditLogs      AuditLog[]
  sessions       Session[]

  @@index([organizationId])
  @@index([branchId])
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  refreshToken String    @unique @map("refresh_token")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model Patient {
  id                    String        @id @default(uuid())
  organizationId        String?       @map("organization_id")
  branchId              String?       @map("branch_id")
  medicalRecordNumber   String        @unique @map("medical_record_number")
  firstName             String        @map("first_name")
  lastName              String        @map("last_name")
  email                 String?       @map("email")
  phoneNumber           String?       @map("phone_number")
  dateOfBirth           DateTime      @map("date_of_birth")
  gender                Gender        @default(UNKNOWN)
  bloodType             BloodType     @default(UNKNOWN) @map("blood_type")
  status                PatientStatus @default(ACTIVE) @map("status")
  address               String?       @map("address")
  emergencyContactName  String?       @map("emergency_contact_name")
  emergencyContactPhone String?       @map("emergency_contact_phone")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")

  organization          Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch                Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([medicalRecordNumber])
  @@index([firstName, lastName])
  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("patients")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
