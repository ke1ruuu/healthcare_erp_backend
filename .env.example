# Application Environment Configuration
# Copy this file to .env and adjust the values according to your local/production environment.

# Node / Server Runtime
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare_erp?schema=public"

# Authentication / Security
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# CORS Configuration (comma-separated origins or *)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Logging & Observability
LOG_LEVEL="debug"
